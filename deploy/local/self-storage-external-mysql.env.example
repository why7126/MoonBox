# MoonBox 本地环境：自建对象存储 + 外部 MySQL。
MOONBOX_DEPLOY_ENV_ID=local-self-storage-external-mysql
APP_NAME=MoonBox
APP_ENV=local
APP_DEBUG=true
TZ=Asia/Shanghai
DATABASE_TIMEZONE=+08:00
APP_SECRET_KEY=change-me-in-local-env

HOST_PORT_BACKEND=18101
HOST_PORT_WEB=18102
HOST_PORT_MINIO_API=18103
HOST_PORT_MINIO_CONSOLE=18104
HOST_PORT_MINTLIFY_DOCS=18105

VITE_API_BASE_URL=http://localhost:18101
DATABASE_TYPE=mysql
DATABASE_DEPLOYMENT_MODE=external-mysql
DATABASE_URL=mysql+pymysql://moonbox:replace-with-password@replace-with-mysql-host:3306/moonbox
MYSQL_DATABASE_URL=mysql+pymysql://moonbox:replace-with-password@replace-with-mysql-host:3306/moonbox

OBJECT_STORAGE_TYPE=minio
OBJECT_STORAGE_DEPLOYMENT_MODE=self-hosted-minio
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_SECURE=false
MINIO_BUCKET=moonbox
OBJECT_STORAGE_KEY_PATTERN={resource_type}/{subtype}/{uuid}.{ext}
OBJECT_STORAGE_PREFIX_IMAGES_ORIGINAL=images/original/
OBJECT_STORAGE_PREFIX_IMAGES_THUMBNAILS=images/thumbnails/
OBJECT_STORAGE_PREFIX_IMAGES_PROCESSED=images/processed/
OBJECT_STORAGE_PREFIX_DOCUMENTS_SOURCE=documents/source/
OBJECT_STORAGE_PREFIX_DOCUMENTS_PREVIEW=documents/preview/
OBJECT_STORAGE_PREFIX_DOCUMENTS_PROCESSED=documents/processed/
OBJECT_STORAGE_PREFIX_IMPORTS_SOURCE=imports/source/
OBJECT_STORAGE_PREFIX_IMPORTS_PROCESSED=imports/processed/
OBJECT_STORAGE_PREFIX_EXPORTS_RESULT=exports/result/
OBJECT_STORAGE_PREFIX_TMP_UPLOADS=tmp/uploads/

