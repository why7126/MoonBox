# ==============================================================================
# MoonBox - 环境变量示例
# ==============================================================================
# 使用方式：复制为 .env 后按本机环境调整。
# 安全边界：不得提交真实密钥、生产凭据、AccessKey、Token 或真实客户数据。

# 应用显示名称；本地开发默认 MoonBox。
APP_NAME=MoonBox
# 应用运行环境；本地开发使用 development，容器默认可使用 local。
APP_ENV=development
# 是否开启调试模式；生产环境必须设为 false。
APP_DEBUG=true
# 应用签名密钥示例值；生产环境必须替换为安全随机值。
APP_SECRET_KEY=change-me-in-local-env
# 管理后台 access token 过期分钟数。
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120
# 预留记住登录天数；当前 MVP 不启用 refresh token。
JWT_REMEMBER_ME_EXPIRE_DAYS=7
# 首次初始化系统内置超级管理员用户名。
ADMIN_USERNAME=admin
# 首次初始化超级管理员示例密码；生产环境禁止使用空密码、示例密码或弱密码。
ADMIN_INITIAL_PASSWORD=change-me-on-first-run
# 开发/演示环境可开启，用真实后端申请接口生成待审批空间申请；生产环境会被忽略。
ADMIN_SPACE_APPLICATION_DEMO_SEED=false

# 后端宿主机端口；MoonBox 本地端口统一使用 39001-39050，容器内端口固定不通过环境变量配置。
HOST_PORT_BACKEND=39001
# Web 宿主机端口；MoonBox 本地端口统一使用 39001-39050。
HOST_PORT_WEB=39002
# MinIO API 宿主机端口；对象存储服务 API 入口。
HOST_PORT_MINIO_API=39003
# MinIO Console 宿主机端口；浏览器管理控制台入口。
HOST_PORT_MINIO_CONSOLE=39004
# 产品手册站点宿主机端口；deploy/docs-site 服务默认使用。
HOST_PORT_MINTLIFY_DOCS=39005

# 后端允许跨域访问的前端来源；多个来源使用英文逗号分隔。
BACKEND_CORS_ORIGINS=http://localhost:39002,http://127.0.0.1:39002
# 可选：本地 Vite dev 或前后端分域构建时使用的 API 基础地址。
# Docker Web 默认通过 nginx 同源 /api 反向代理访问后端，运行期不需要配置该变量。
# VITE_API_BASE_URL=http://localhost:39001
# 需求中心 BFF 在容器内读取的治理事实源根目录；Compose 默认只读挂载到 /app/governance。
MOONBOX_GOVERNANCE_ROOT=/app/governance

# 数据库类型；开发环境默认 sqlite，生产环境必须显式设置为 mysql。
DATABASE_TYPE=sqlite
# 统一数据库连接串；开发环境默认 SQLite，生产环境必须改为 MySQL。
DATABASE_URL=sqlite:////app/data/sqlite/moonbox.db
# SQLite 专用连接串；用于本地开发和自动化测试。
SQLITE_DATABASE_URL=sqlite:////app/data/sqlite/moonbox.db
# MySQL 连接串示例；仅用于生产或 MySQL 兼容验证，不得提交真实凭据。
MYSQL_DATABASE_URL=mysql+pymysql://moonbox:change-me@mysql:3306/moonbox
# MySQL 字符集、排序规则和数据库时区；MoonBox 默认使用北京时区。
MYSQL_CHARSET=utf8mb4
MYSQL_COLLATION=utf8mb4_0900_ai_ci
DATABASE_TIMEZONE=+08:00
# 数据库部署模式；sqlite、self-hosted-mysql、external-mysql 三选一，用于部署文档和脚本说明。
DATABASE_DEPLOYMENT_MODE=sqlite

# 对象存储类型；当前本地开发使用 MinIO。
OBJECT_STORAGE_TYPE=minio
# 对象存储部署模式；self-hosted-minio 表示使用 Compose 内置 MinIO，external-minio 表示连接外部 S3/MinIO 兼容服务。
OBJECT_STORAGE_DEPLOYMENT_MODE=self-hosted-minio
# MinIO 服务地址；容器间访问使用服务名 minio:9000。
MINIO_ENDPOINT=minio:9000
# MinIO AccessKey 示例值；生产环境必须替换。
MINIO_ACCESS_KEY=change-me
# MinIO SecretKey 示例值；生产环境必须替换。
MINIO_SECRET_KEY=change-me
# 是否使用 HTTPS 访问 MinIO；本地开发默认 false。
MINIO_SECURE=false
# 默认对象存储桶；MoonBox 使用“一个项目一个 Bucket”策略。
MINIO_BUCKET=moonbox
# MinIO 镜像；本地默认使用 latest，可按需固定为 Docker Hub 已发布的 RELEASE tag。
MINIO_IMAGE=minio/minio:latest
# 对象 Key 规则；桶内用二级目录/前缀区分资源类型。
OBJECT_STORAGE_KEY_PATTERN={resource_type}/{subtype}/{uuid}.{ext}
# 图片原始文件前缀。
OBJECT_STORAGE_PREFIX_IMAGES_ORIGINAL=images/original/
# 图片缩略图前缀。
OBJECT_STORAGE_PREFIX_IMAGES_THUMBNAILS=images/thumbnails/
# 图片处理产物前缀。
OBJECT_STORAGE_PREFIX_IMAGES_PROCESSED=images/processed/
# 文档原始文件前缀。
OBJECT_STORAGE_PREFIX_DOCUMENTS_SOURCE=documents/source/
# 文档预览文件前缀。
OBJECT_STORAGE_PREFIX_DOCUMENTS_PREVIEW=documents/preview/
# 文档处理产物前缀。
OBJECT_STORAGE_PREFIX_DOCUMENTS_PROCESSED=documents/processed/
# 导入源文件前缀。
OBJECT_STORAGE_PREFIX_IMPORTS_SOURCE=imports/source/
# 导入处理产物前缀。
OBJECT_STORAGE_PREFIX_IMPORTS_PROCESSED=imports/processed/
# 导出结果文件前缀。
OBJECT_STORAGE_PREFIX_EXPORTS_RESULT=exports/result/
# 上传临时文件前缀。
OBJECT_STORAGE_PREFIX_TMP_UPLOADS=tmp/uploads/

# 本地数据根目录；运行时数据不得提交 Git。
DATA_ROOT=./data
# 上传文件在容器内的临时/持久化目录。
UPLOAD_DIR=/app/data/uploads
# 处理后文件在容器内的输出目录。
PROCESSED_DIR=/app/data/processed
# 临时文件在容器内的工作目录。
TMP_DIR=/app/data/tmp

# 是否启用媒体能力；当前启用图片和文档。
MEDIA_ENABLED=true
# 单文件上传大小上限，单位 MB。
MAX_UPLOAD_SIZE_MB=100

# Chat 平台仅在将 MOONBOX_CHAT_EXECUTION_MODE 设为 local-codex 后启用。
# 部署脚本根据下方仓库与空间生成白名单、目录绑定，并注入执行策略与保留策略。
# Chat 本地自动快照数量上限；默认2，0仅关闭自动创建，不清理历史副本或独立删除日志。
MOONBOX_CHAT_LOCAL_SNAPSHOT_LIMIT=2

# 显式 --chat-platform 单机部署；仓库、空间必须由部署者指定，空值阻止启动。
MOONBOX_CHAT_REPOSITORY_ID=
MOONBOX_CHAT_SPACE_ID=
MOONBOX_CHAT_SOURCE_ROOT=
# 私有持久化根目录；留空由脚本使用项目 data/runtime/chat-platform。
MOONBOX_CHAT_HOST_ROOT=
# 单文件凭证来源；留空使用部署用户的 Codex auth.json，不挂载个人配置目录。
MOONBOX_CHAT_AUTH_SOURCE=
# Docker socket 所属组；Linux 非root控制器按实际组设置。
MOONBOX_CHAT_DOCKER_GID=0
# 设置为 local-codex 后使用根目录部署脚本启动；常规部署保持关闭。
MOONBOX_CHAT_EXECUTION_MODE=disabled

# REQ-0044：验证环境默认关闭；启用时填写受控 runner 的不可变本地镜像 ID（sha256:...）。
MOONBOX_VERIFICATION_IMAGE_ID=
# runner 的精确 Node 版本、目标 OS 和架构；必须与实际镜像探针一致。
MOONBOX_VERIFICATION_NODE_VERSION=
# runner 镜像内 pnpm 的精确版本；须匹配项目 packageManager 声明。
MOONBOX_VERIFICATION_PNPM_VERSION=
MOONBOX_VERIFICATION_OS=linux
MOONBOX_VERIFICATION_ARCH=
# 服务端只读制品根目录；缺失时预检报告 unavailable，不尝试在线安装。
MOONBOX_VERIFICATION_ARTIFACT_ROOT=
# 受控依赖源 HTTPS URL；空值时不会向外部仓库发送锁文件依赖请求。
MOONBOX_VERIFICATION_REGISTRY_URL=
# 预先建立的制品准备 Docker 网络名；空值或 none 时不可在线准备。
MOONBOX_VERIFICATION_PREPARE_NETWORK=
# 验证浏览器只接入受控预览网络；自定义 COMPOSE_NETWORK_NAME 时须同步设置。
MOONBOX_VERIFICATION_BROWSER_NETWORK=moonbox-network

# 常驻Chat部署的Capture写入模式：continuous持续启用；disabled保留限时维护窗口。
MOONBOX_GOVERNANCE_CAPTURE_MODE=continuous
# 治理私有镜像与心跳目录，留空时部署脚本使用项目data/runtime/governance；0700且禁止提交。
MOONBOX_GOVERNANCE_HOST_STATE_ROOT=

# 受控规则替代的外部只读信任文件；空值阻断替代批准，不从仓库加载根。
MOONBOX_REPLACEMENT_TRUST_FILE=
# 后端到隔离签名服务的 Unix socket；不得挂载到 Agent/worker 执行环境。
MOONBOX_REPLACEMENT_SIGNER_SOCKET=
# 仅签名服务配置的私钥文件（私有挂载，0600）；后端与 Agent 不读取。
MOONBOX_AUTHORIZATION_PRIVATE_KEY=
# 签名服务当前密钥版本标识；历史公钥由信任文件保留。
MOONBOX_AUTHORIZATION_KEY_ID=
# 仅签名服务配置：可选 JSON 用途子集；不设置时允许已实现的所有者与提交用途，永不允许 bootstrap.ops。
# 不配置空字符串；设置时必须为非空、无重复的用途数组。

# 首次可信启用为显式可选部署：--chat-platform --controlled-replacement。
# 以下外部路径由运维配置；不会自动生成可信根或独立授权。
MOONBOX_REPLACEMENT_TRUST_SOURCE=
MOONBOX_AUTHORIZATION_KEY_SOURCE=
MOONBOX_AUTHORIZATION_KEY_ID=
MOONBOX_REPLACEMENT_SOCKET_ROOT=
