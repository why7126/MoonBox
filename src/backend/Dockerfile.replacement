# Explicit controlled-replacement deployment; pinned toolchain and no operations key.
FROM node:22.22.0-bookworm-slim AS toolchain
WORKDIR /opt/moonbox-toolchain
COPY container/toolchain/package*.json ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund
FROM python:3.12-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 OPENSPEC_TELEMETRY=0 DO_NOT_TRACK=1 PATH="/opt/moonbox-toolchain/node_modules/.bin:${PATH}"
COPY pyproject.toml ./
RUN pip install --no-cache-dir . && apt-get update && apt-get install -y --no-install-recommends git libstdc++6 ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=toolchain /usr/local/bin/node /usr/local/bin/node
COPY --from=toolchain /opt/moonbox-toolchain /opt/moonbox-toolchain
COPY app ./app
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
