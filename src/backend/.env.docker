# 文档用途：Docker Compose 后端环境变量
# 文档内容：容器内FastAPI、SQLite、MinIO、上传与视频处理配置
# 内容来源：AI自动生成，项目团队确认
# 更新方式：docker-compose.yml或后端配置变化时同步更新
# 备注：仅用于本地开发和演示，不用于生产

APP_ENV=development
LOG_LEVEL=INFO
BACKEND_HOST=0.0.0.0
BACKEND_CORS_ORIGINS=http://localhost:18102
DATABASE_TYPE=sqlite
DATABASE_URL=sqlite:////app/data/sqlite/moonbox.db
SQLITE_DATABASE_URL=sqlite:////app/data/sqlite/moonbox.db
MYSQL_DATABASE_URL=mysql+pymysql://moonbox:change-me@mysql:3306/moonbox
MYSQL_CHARSET=utf8mb4
MYSQL_COLLATION=utf8mb4_0900_ai_ci
DATABASE_TIMEZONE=+08:00
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:18103
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=moonbox
MINIO_SECURE=false
OBJECT_STORAGE_PREFIX_IMAGES_AVATARS=images/avatars/
MAX_IMAGE_SIZE_MB=20
MAX_VIDEO_SIZE_MB=500
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
ALLOWED_VIDEO_TYPES=video/mp4,video/quicktime,video/x-msvideo
VIDEO_PROCESSING_ENABLED=true
VIDEO_TRANSCODE_ENABLED=false
VIDEO_THUMBNAIL_ENABLED=true
